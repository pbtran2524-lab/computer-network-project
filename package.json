{
  "name": "agent-console",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "node server.bundle.js",
    "dev": "concurrently -n server,client -c blue,green \"node server.js\" \"vite\"",
    "build": "vite build && node_modules\\.bin\\esbuild server.js --bundle --platform=node --target=node22 --outfile=server.bundle.js",
    "setup": "npm install && npm run build"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
